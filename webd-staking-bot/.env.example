# ── Telegram ──────────────────────────────────────────────────────────────────
# Obtine de la @BotFather pe Telegram
TELEGRAM_TOKEN=1234567890:AAF...

# ── WhatsApp (Twilio) ─────────────────────────────────────────────────────────
# Cont gratuit pe twilio.com → Sandbox WhatsApp
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# URL public pentru webhook (ex: ngrok sau VPS)
WEBHOOK_URL=https://myserver.duckdns.org
WHATSAPP_PORT=5005

# ── Staking API (VPS) ─────────────────────────────────────────────────────────
STAKING_API_URL=http://localhost:3004
STAKING_API_SECRET=SECRET_SECRET_SECRET_LONG_SECRET_123456

# ── Explorer / Price ──────────────────────────────────────────────────────────
EXPLORER_API_URL=https://explorer.webdollar.io

# ── Tip Bot Staking (adresa proprie, separata de pool-ul principal) ───────────
# Adresa WEBD a botului (generata cu tx_builder — adresa la care userii depun)
TIP_BOT_ADDRESS=WEBD$...
TIP_BOT_SEED=<seed hex 64 chars>
TIP_BOT_PUBKEY=<pubkey hex 64 chars>

# ── Nod WEBD ─────────────────────────────────────────────────────────────────
NODE_URL=http://localhost:5555
NODE_LOCAL_URL=http://127.0.0.1:8081
BROADCAST_URL=http://localhost:3001/tx/broadcast
# Secretul API al nodului legacy (din URL-ul /SECRET/wallets/create-transaction)
NODE_SECRET_KEY=SECRET_SECRET_SECRET_LONG_SECRET_123456

# ── Bot general ───────────────────────────────────────────────────────────────
ADMIN_TELEGRAM_ID=123456789
TIP_FEE_PCT=0
MIN_TIP=1
MIN_WITHDRAW=20
DB_PATH=tipbot.db
