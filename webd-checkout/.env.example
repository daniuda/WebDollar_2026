# URL nod WebDollar pentru verificare balanță/tranzacții
# Poate fi nodul propriu (webd-node-modern) sau un nod public
NODE_URL=https://webdollar.io

# Port pe care ascultă serverul checkout
PORT=3002

# Timeout sesiune plată (ms) — default 10 minute
PAYMENT_TIMEOUT_MS=600000

# Origin permis pentru CORS (pune domeniul tău sau * pentru orice)
CORS_ORIGIN=*
